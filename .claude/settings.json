{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_LSP_TOOL": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read(**/.env*)",
      "Read(**/env.php*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/.secrets*)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(**/docker-compose*.yml)",
      "Read(**/config/database.yml)",
      "Read(**/secrets.fish)"
    ],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          },
          {
            "type": "command",
            "command": "/opt/homebrew/bin/caveman shrink-hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.clawd-tank/clawd-tank-notify",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.caveman/bin/caveman-proxy native-hook claude --adapter /opt/homebrew/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "church@church": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "humanizer@humanizer": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "theme": "custom:tokyo-night",
  "editorMode": "normal",
  "terminalProgressBarEnabled": false
}
